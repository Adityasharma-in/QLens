{
  "manifest_version": 3,
  "name": "QLens — Quick Search Overlay",
  "short_name": "QLens",
  "version": "1.1.1",
  "description": "Search Google, Brave, Bing, or DuckDuckGo from any page with one shortcut. No copy-paste needed.",
  "minimum_chrome_version": "111",
  "permissions": ["scripting", "storage", "contextMenus"],
  "host_permissions": ["https://suggestqueries.google.com/*", "https://www.google.com/*", "https://lens.google.com/*", "http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/shared/config.js",
        "src/shared/messaging.js",
        "src/shared/engines.js",
        "src/shared/calculator.js",
        "src/shared/logos.js",
        "src/shared/async.js",
        "src/shared/storage.js",
        "src/shared/image.js",
        "src/content/selection.js",
        "src/content/overlay.js",
        "src/content/injector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "commands": {
    "open-quick-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "MacCtrl+Shift+K"
      },
      "description": "Open QLens quick search overlay"
    }
  },
  "omnibox": { "keyword": "ql" },
  "options_page": "src/options/options.html",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "QLens — quick search",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/fonts/*.woff2"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ],
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}